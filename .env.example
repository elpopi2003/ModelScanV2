# Copia este archivo a .env.local y rellena los valores del proyecto Supabase.
# Estas variables son públicas (van al bundle del cliente); la seguridad real
# la da RLS en la base de datos, no el secreto de la clave.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# --- Secretos del backend (NO van aquí) ---
# Se configuran como "secrets" de las Edge Functions en el panel de Supabase:
#   GEMINI_API_KEY     -> identify-kit  (Google AI Studio)
#   FIRECRAWL_API_KEY  -> scalemates-search (Firecrawl)
